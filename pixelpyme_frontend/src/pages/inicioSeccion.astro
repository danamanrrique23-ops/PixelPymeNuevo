---
import "../styles/login.css";
---
<html lang="es"> <head> <meta charset="UTF-8" /> <meta name="viewport" content="width=device-width, initial-scale=1.0" /> <title>Iniciar sesión</title> </head>

<body> <main class="login-container"> <div class="login-card">

    <div class="icon">🔧</div>

    <h1>Bienvenido</h1>

    <p class="subtitle">Inicia sesión en PixelPyme</p>

    <form id="loginForm">

      <div class="input-group">
        <label for="email">Correo electrónico</label>

        <input
          type="email"
          id="email"
          placeholder="Ingresa tu correo"
          autocomplete="off"
          required
        />
      </div>

      <div class="input-group">
        <label for="password">Contraseña</label>

        <div class="password-container">
          <input
            type="password"
            id="password"
            placeholder="Ingresa tu contraseña"
            autocomplete="new-password"
            required
          />

          <button
            type="button"
            id="mostrarPassword"
            class="password-toggle"
            aria-label="Mostrar contraseña"
          >
            👁️
          </button>
        </div>
      </div>

      <div class="recuperar-link">
        <a href="/recuperar-contrasena">
          ¿Olvidaste tu contraseña?
        </a>
      </div>

      <button type="submit">
        Iniciar sesión
      </button>

      <button
        type="button"
        class="google-btn"
        onclick="window.location.href='http://127.0.0.1:8001/api/auth/google'"
      >
        <span class="google-icon">G</span>
        <span>Continuar con Google</span>
      </button>

      <div class="registro-link">
        <span>¿No tienes una cuenta?</span>
        <a href="/registro">Regístrate aquí</a>
      </div>

      <p id="mensaje"></p>

    </form>

  </div>
</main>

    <script>
      const formulario =
        document.getElementById("loginForm") as HTMLFormElement;

      const mensaje =
        document.getElementById("mensaje") as HTMLParagraphElement;

        const passwordInput= 
        document.getElementById("password") as HTMLInputElement;

        const mostrarpassword = 
        document.getElementById("mostrarPassword") as HTMLButtonElement;

         mostrarpassword.addEventListener("click", () => {
          if (passwordInput.type === "password"){
            passwordInput.type = "text"
          } else {
            passwordInput.type="password"
          }
        });
      

      formulario.addEventListener("submit", async (event) => {
        event.preventDefault();

        const email =
          (document.getElementById("email") as HTMLInputElement).value;

        const password =
          (document.getElementById("password") as HTMLInputElement).value;

        console.log("Email:", email);
        console.log("Password:", password);

    

        try {
          const respuesta = await fetch(
            "http://localhost:8001/api/login",
            {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({
                email: email,
                password: password
              })
            }
          );

          console.log("STATUS:", respuesta.status);

          const datos = await respuesta.json();

          console.log("DATOS:", datos);
          console.log("ROL:", datos.rol);
          console.log("USUARIO RECIBIDO:", datos.usuario);
          console.log("ID RECIBIDO:", datos.usuario?.id);

          if (respuesta.ok) {

            // Mensaje de éxito
            mensaje.textContent =
              "Inicio de sesión exitoso ✅";

            mensaje.className = "exito";

            // Guardar token
            localStorage.setItem(
              "token",
              datos.token
            );

            // Guardar ID del usuario
            if (datos.usuario?.id !== undefined) {

              localStorage.setItem(
                "usuario_id",
                String(datos.usuario.id)
              );

              console.log(
                "ID guardado:",
                datos.usuario.id
              );

            } else {

              console.error(
                "El backend no está enviando el ID del usuario"
              );
            }

console.log("USUARIO COMPLETO:", datos.usuario);
if (datos.usuario) {
  localStorage.setItem(
    "usuario_nombre",
    `${datos.usuario.nombre} ${datos.usuario.apellido}`
  );

  console.log(
    "Nombre guardado:",
    datos.usuario.nombre,
    datos.usuario.apellido
  );
}
const rol = datos.rol?.toLowerCase();

if (rol === "administrador") {
  setTimeout(() => {
    window.location.href = "/Administrador";
  }, 1500);
} else if (rol === "usuario") {
  setTimeout(() => {
    window.location.href = "/usuario";
  }, 1500);
} else {
  mensaje.textContent = "Rol no reconocido";
  mensaje.className = "error";
}

    
         

          } else {

            // Error de login
            mensaje.textContent =
              datos.Message ||
              datos.mensaje ||
              "Correo o contraseña incorrectos";

            mensaje.className = "error";
          }

        } catch (error) {

          console.error(
            "Error al conectar con el servidor:",
            error
          );

          mensaje.textContent =
            "No se pudo conectar con el servidor";

          mensaje.className = "error";
        }
      });
    </script>


  </body>
</html>


