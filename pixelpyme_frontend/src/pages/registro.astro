---
import "../styles/registro.css";
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Crear cuenta</title>
</head>

<body>

  <div class="registro-container">


<div class="registro-card">

  <div class="icono">👤</div>

  <h1>Crear cuenta</h1>
  <p class="subtitulo">Regístrate para acceder a PixelPime</p>
  <form id="registroForm" autocomplete="off">


    <div class="campo">
      <label for="nombres">Nombres</label>
      <input
        type="text"
        id="nombres"
        placeholder="Ingresa tus nombres"
        required
      />
    </div>

    <div class="campo">
      <label for="apellidos">Apellidos</label>
      <input
        type="text"
        id="apellidos"
        placeholder="Ingresa tus apellidos"
        required
      />
    </div>

    <div class="campo">
  <label for="email">Correo electrónico</label>

  <input
    type="email"
    id="email"
    name="email"
    placeholder="ejemplo@correo.com"
    required
  />
</div>

    <div class="campo">

  <label for="password">Crear contraseña</label>

  <div class="password-container">

    <input
      type="password"
      id="password"
      placeholder="Ingresa una contraseña"
      autocomplete="new-password"
      required
    />

    <button
      type="button"
      class="ojo"
      id="btnPassword"
    >
      👁️
    </button>

  </div>

</div>


<div class="campo">

  <label for="confirmPassword">Confirmar contraseña</label>

  <div class="password-container">

    <input
      type="password"
      id="confirmPassword"
      placeholder="Confirma tu contraseña"
      autocomplete="new-password"
      required
    />

    <button
      type="button"
      class="ojo"
      id="btnConfirmPassword"
    >
      👁️
    </button>

  </div>

</div>

     
    <button type="submit" id="btnRegistro">
      Registrarse
    </button>

    <p id="mensaje"></p>

  </form>

  <p class="login-text">
    ¿Ya tienes una cuenta?
    <a href="/inicioSeccion">Inicia sesión</a>
  </p>

  <a href="/" class="boton-catalogo">
  🛋️ Volver al Catálogo
</a>
</div>


  </div>
<script>
  const formulario =
    document.getElementById("registroForm") as HTMLFormElement;

  const mensaje =
    document.getElementById("mensaje") as HTMLElement;

  const btnRegistro =
    document.getElementById("btnRegistro") as HTMLButtonElement;

  const passwordInput =
    document.getElementById("password") as HTMLInputElement;

  const confirmPasswordInput =
    document.getElementById("confirmPassword") as HTMLInputElement;

  const botonPassword =
    document.getElementById("btnPassword") as HTMLButtonElement;

  const botonConfirmPassword =
    document.getElementById("btnConfirmPassword") as HTMLButtonElement;


  // Mostrar / ocultar contraseña
  botonPassword.addEventListener("click", () => {
    if (passwordInput.type === "password") {
      passwordInput.type = "text"; 
    } else {
      passwordInput.type = "password";
   }
  });


  // Mostrar / ocultar confirmación
  botonConfirmPassword.addEventListener("click", () => {
    if (confirmPasswordInput.type === "password") {
      confirmPasswordInput.type = "text";
    } else {
      confirmPasswordInput.type = "password";
    }
  });


  // Registrar usuario
  formulario.addEventListener("submit", async (evento) => {

    evento.preventDefault();

    mensaje.textContent = "";

    btnRegistro.disabled = true;
    btnRegistro.textContent = "Registrando...";


    const nombres =
      (document.getElementById("nombres") as HTMLInputElement).value.trim();

    const apellidos =
      (document.getElementById("apellidos") as HTMLInputElement).value.trim();

    const email =
      (document.getElementById("email") as HTMLInputElement).value.trim();

    const password =
      passwordInput.value;

    const confirmPassword =
      confirmPasswordInput.value;


    // Validar campos
    if (
      !nombres ||
      !apellidos ||
      !email ||
      !password ||
      !confirmPassword
    ) {

      mensaje.textContent =
        "❌ Completa todos los campos.";

      btnRegistro.disabled = false;
      btnRegistro.textContent = "Registrarse";

      return;
    }


    // Validar contraseñas
    if (password !== confirmPassword) {

      mensaje.textContent =
        "❌ Las contraseñas no coinciden.";

      btnRegistro.disabled = false;
      btnRegistro.textContent = "Registrarse";

      return;
    }


    const datosRegistro = {
      nombres,
      apellidos,
      email,
      password
    };


    console.log(
      "Datos enviados al backend:",
      datosRegistro
    );


    try {

      const respuesta = await fetch(
        "http://localhost:8001/registro",
        {
          method: "POST",

          headers: {
            "Content-Type": "application/json"
          },

          body: JSON.stringify(datosRegistro)
        }
      );


      const datos = await respuesta.json();


      console.log(
        "Estado:",
        respuesta.status
      );

      console.log(
        "Respuesta:",
        datos
      );


      if (!respuesta.ok) {

        mensaje.textContent =
          `❌ ${
            datos.Message ||
            datos.mensaje ||
            datos.error ||
            "No se pudo registrar el usuario"
          }`;

        return;
      }


      mensaje.textContent =
      "✅ Usuario registrado correctamente.";
      formulario.reset();
      setTimeout(() => {
     window.location.href = "/inicioSeccion";
      }, 1500);


     } catch (error) {

      console.error(
        "Error al registrar:",
        error
      );

      mensaje.textContent =
        "❌ No se pudo conectar con el servidor.";

    } finally {

      btnRegistro.disabled = false;
      btnRegistro.textContent = "Registrarse";

    }

  });
</script>
  

</body>
</html>