---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Crear cuenta</title>
</head>

<body>

  <div class="registro-container">


<div class="registro-card">

  <div class="icono">👤</div>

  <h1>Crear cuenta</h1>
  <p class="subtitulo">Regístrate para acceder a PixelPime</p>
  <form id="registroForm" autocomplete="off">


    <div class="campo">
      <label for="nombres">Nombres</label>
      <input
        type="text"
        id="nombres"
        placeholder="Ingresa tus nombres"
        required
      />
    </div>

    <div class="campo">
      <label for="apellidos">Apellidos</label>
      <input
        type="text"
        id="apellidos"
        placeholder="Ingresa tus apellidos"
        required
      />
    </div>

    <div class="campo">
  <label for="email">Correo electrónico</label>

  <input
    type="email"
    id="email"
    name="email"
    placeholder="ejemplo@correo.com"
    required
  />
</div>

    <div class="campo">

  <label for="password">Crear contraseña</label>

  <div class="password-container">

    <input
      type="password"
      id="password"
      placeholder="Ingresa una contraseña"
      autocomplete="new-password"
      required
    />

    <button
      type="button"
      class="ojo"
      id="btnPassword"
    >
      👁️
    </button>

  </div>

</div>


<div class="campo">

  <label for="confirmPassword">Confirmar contraseña</label>

  <div class="password-container">

    <input
      type="password"
      id="confirmPassword"
      placeholder="Confirma tu contraseña"
      autocomplete="new-password"
      required
    />

    <button
      type="button"
      class="ojo"
      id="btnConfirmPassword"
    >
      👁️
    </button>

  </div>

</div>

     
    <button type="submit" id="btnRegistro">
      Registrarse
    </button>

    <p id="mensaje"></p>

  </form>

  <p class="login-text">
    ¿Ya tienes una cuenta?
    <a href="/inicioSeccion">Inicia sesión</a>
  </p>

</div>


  </div>
<script>
  const formulario =
    document.getElementById("registroForm") as HTMLFormElement;

  const mensaje =
    document.getElementById("mensaje") as HTMLElement;

  const btnRegistro =
    document.getElementById("btnRegistro") as HTMLButtonElement;

  const passwordInput =
    document.getElementById("password") as HTMLInputElement;

  const confirmPasswordInput =
    document.getElementById("confirmPassword") as HTMLInputElement;

  const botonPassword =
    document.getElementById("btnPassword") as HTMLButtonElement;

  const botonConfirmPassword =
    document.getElementById("btnConfirmPassword") as HTMLButtonElement;


  // Mostrar / ocultar contraseña
  botonPassword.addEventListener("click", () => {
    if (passwordInput.type === "password") {
      passwordInput.type = "text"; 
    } else {
      passwordInput.type = "password";
   }
  });


  // Mostrar / ocultar confirmación
  botonConfirmPassword.addEventListener("click", () => {
    if (confirmPasswordInput.type === "password") {
      confirmPasswordInput.type = "text";
    } else {
      confirmPasswordInput.type = "password";
    }
  });


  // Registrar usuario
  formulario.addEventListener("submit", async (evento) => {

    evento.preventDefault();

    mensaje.textContent = "";

    btnRegistro.disabled = true;
    btnRegistro.textContent = "Registrando...";


    const nombres =
      (document.getElementById("nombres") as HTMLInputElement).value.trim();

    const apellidos =
      (document.getElementById("apellidos") as HTMLInputElement).value.trim();

    const email =
      (document.getElementById("email") as HTMLInputElement).value.trim();

    const password =
      passwordInput.value;

    const confirmPassword =
      confirmPasswordInput.value;


    // Validar campos
    if (
      !nombres ||
      !apellidos ||
      !email ||
      !password ||
      !confirmPassword
    ) {

      mensaje.textContent =
        "❌ Completa todos los campos.";

      btnRegistro.disabled = false;
      btnRegistro.textContent = "Registrarse";

      return;
    }


    // Validar contraseñas
    if (password !== confirmPassword) {

      mensaje.textContent =
        "❌ Las contraseñas no coinciden.";

      btnRegistro.disabled = false;
      btnRegistro.textContent = "Registrarse";

      return;
    }


    const datosRegistro = {
      nombres,
      apellidos,
      email,
      password
    };


    console.log(
      "Datos enviados al backend:",
      datosRegistro
    );


    try {

      const respuesta = await fetch(
        "http://localhost:8001/registro",
        {
          method: "POST",

          headers: {
            "Content-Type": "application/json"
          },

          body: JSON.stringify(datosRegistro)
        }
      );


      const datos = await respuesta.json();


      console.log(
        "Estado:",
        respuesta.status
      );

      console.log(
        "Respuesta:",
        datos
      );


      if (!respuesta.ok) {

        mensaje.textContent =
          `❌ ${
            datos.Message ||
            datos.mensaje ||
            datos.error ||
            "No se pudo registrar el usuario"
          }`;

        return;
      }


      mensaje.textContent =
      "✅ Usuario registrado correctamente.";
      formulario.reset();
      setTimeout(() => {
     window.location.href = "/inicioSeccion";
      }, 1500);


     } catch (error) {

      console.error(
        "Error al registrar:",
        error
      );

      mensaje.textContent =
        "❌ No se pudo conectar con el servidor.";

    } finally {

      btnRegistro.disabled = false;
      btnRegistro.textContent = "Registrarse";

    }

  });
</script>
  <style>

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
  min-height: 100vh;
      background: linear-gradient(135deg, #021670, #052170, #132556);

}

    .registro-container {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 30px;
    }

    .registro-card {
      width: 200%;
      max-width: 650px;
      background: white;
      padding: 40px;
      border-radius: 20px;
      box-shadow: 0 12px 35px rgba(0, 0, 0, 0.12);
    }

    .icono {
      width: 65px;
      height: 65px;
      margin: 0 auto 15px;
      background: #e8f1ff;
      border-radius: 50%;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 30px;
    }

    h1 {
      text-align: center;
       font-size: 34px;
    color: #000000;
    margin-bottom: 30px;
    font-weight: 900;
    
    }

    .subtitulo {
      text-align: center;
      color: #6b7280;
      margin-bottom: 30px;
      font-size: 14px;
    }

    .campo {
      
        margin-bottom: 8px;
        color: #0b0a0a;
        font-size: 20px;
        font-weight: bold;
    }

    
    input {
      width: 100%;
      padding: 13px 14px;
      border: 1px solid #d1d5db;
      border-radius: 10px;
      font-size: 15px;
      outline: none;
    }

    input:focus {
      border-color: #4f8cff;
      box-shadow: 0 0 0 3px rgba(79, 140, 255, 0.12);
    }

  

         
       button {
        width: 100%;
        padding: 14px;

        border: none;
        border-radius: 10px;

        background: linear-gradient(#021670);

        color: white;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.3s;
    }

    button:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(102, 126, 234, 0.35);
    }

    button:active {
        transform: translateY(0);
    }
      
   
    

    button:disabled {
      opacity: 0.7;
      cursor: not-allowed;
    }

    #mensaje {
      text-align: center;
      margin-top: 15px;
      font-size: 14px;
      font-weight: bold;
    }

    .error {
      color: #dc2626;
    }

    .exito {
      color: #16a34a;
    }

    .login-text {
      text-align: center;
      margin-top: 25px;
      color: #6b7280;
      font-size: 14px;
    }

    .login-text a {
      color: #032c76;
      font-weight: bold;
      text-decoration: none;
    }

    .login-text a:hover {
      text-decoration: underline;

    }


    .password-container {
  position: relative;
  width: 100%;
}

.password-container input {
  padding-right: 50px;
}

.ojo {
  position: absolute;
  right: 10px;
  top: 45%;
  transform: translateY(-50%);
  width: 40px;
  height: 40px;
  padding: 0;
  margin: 0;
  background: transparent;
  color: #333;
  border: none;
  box-shadow: none;
  font-size: 20px;
  cursor: pointer;
}

.ojo:hover {
  transform: translateY(-50%);
  background: transparent;
  box-shadow: none;
}

.ojo:active {
  transform: translateY(-50%);
}

  </style>

</body>
</html>